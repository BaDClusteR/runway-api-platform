; The environment of the tests: it overrides .env and .env.local of the package.
APP_DEBUG=false
LOG_LEVEL=4

; SQLite in memory: the tables are created by the tests (see Fixture\AuthTables).
DSN="sqlite::memory:"
DB_PREFIX="test_"

API_AUTH_ENABLED=true
API_TOKEN_HEADER="X-Token"
API_ALLOW_ORIGIN="https://app.example"
API_ALLOW_METHODS="POST, GET, PUT, PATCH, DELETE, OPTIONS"
API_ALLOW_HEADERS="Content-Type, X-Token"
TRUSTED_PROXIES=
