{
  "name": "bad_cluster/runway-api-platform",
  "type": "library",
  "description": "API platform for Runway: endpoints as router routes, argument validation, JSON errors, authorization, CORS and the OpenAPI spec",
  "keywords": ["runway", "api", "api-platform"],
  "license": "BSD-3-Clause",
  "authors": [
    {"name": "BaD ClusteR", "email": "admin@badcluster.ru"}
  ],
  "require": {
    "php": ">=8.4",
    "ext-simplexml": "*",
    "ext-dom": "*",
    "ext-mbstring": "*",
    "ext-zip": "*",
    "bad_cluster/runway": "dev-main"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "phpunit/phpunit": "^13.4",
    "phpstan/phpstan": "^2.3",
    "infection/infection": "^0.35",
    "ext-pdo_sqlite": "*"
  },
  "autoload": {
    "psr-4": {"ApiPlatform\\" : "src/"},
    "files": ["bootstrap.php"]
  },
  "autoload-dev": {
    "psr-4": {"ApiPlatform\\Tests\\": "tests/"}
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration",
    "test:e2e": "phpunit --testsuite e2e",
    "phpstan": "phpstan --memory-limit=1G",
    "infection": "infection --threads=max"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "infection/extension-installer": true
    }
  }
}
