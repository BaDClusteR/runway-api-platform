; Comma-separated origins allowed to call the API from a browser on another site (CORS), e.g.
; https://app.example.com. An asterisk allows any site. Empty: only the pages of the API site itself.
API_ALLOW_ORIGIN=
API_ALLOW_METHODS='POST, GET, PUT, PATCH, DELETE, OPTIONS'
API_ALLOW_HEADERS='Content-Type, X-Token'
API_TOKEN_HEADER='X-Token'

; false: every endpoint is public, e.g. the access is limited by the web server: by IP, basic auth, etc.
API_AUTH_ENABLED=true

; Required only with the authorization enabled.
API_CRYPTO_KEY=
API_CRYPTO_KEY_LENGTH=
API_AUTH_HASH=
